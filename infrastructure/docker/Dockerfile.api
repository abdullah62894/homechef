# HomeChef ASP.NET Core API — multi-stage build.
# Refined in Stage 14 (production deployment).

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY backend/HomeChef.slnx backend/
COPY backend/src/HomeChef.Domain/HomeChef.Domain.csproj backend/src/HomeChef.Domain/
COPY backend/src/HomeChef.Application/HomeChef.Application.csproj backend/src/HomeChef.Application/
COPY backend/src/HomeChef.Infrastructure/HomeChef.Infrastructure.csproj backend/src/HomeChef.Infrastructure/
COPY backend/src/HomeChef.Api/HomeChef.Api.csproj backend/src/HomeChef.Api/
COPY backend/tests/HomeChef.Api.Tests/HomeChef.Api.Tests.csproj backend/tests/HomeChef.Api.Tests/
RUN dotnet restore backend/HomeChef.slnx

COPY backend/src backend/src
COPY backend/tests backend/tests
RUN dotnet publish backend/src/HomeChef.Api/HomeChef.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
# Render injects PORT at runtime; bind to it when set, else fall back to 8080.
ENTRYPOINT ["sh", "-c", "ASPNETCORE_URLS=http://+:${PORT:-8080} dotnet HomeChef.Api.dll"]